// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  //output   = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions", "fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  extensions = [pgvector(map: "vector")]
}

model Paper {
  id                        Int       @id @default(autoincrement())
  entry_id                  String    @unique
  title                     String
  authors                   String?
  abstract                  String?
  categories                String?
  published                 DateTime?
  updated                   DateTime?
  doi                       String?
  journal_ref               String?
  license                   String?
  url                       String?
  s2_id                     String?   @unique
  non_arxiv_citation_count  Int?
  non_arxiv_reference_count Int?
  related_arxiv_ids         Json?
  // wird für die python anwendung benutzt um die koordinaten für umap bereitzustellen
  tsne                      Json?

  // Abgeleitete Spalten (gepflegt von der Python-Pipeline bzw. import_dataset.py):
  // - category_list: alle Kategorien als Array → exakter Match ("cs.CL" trifft
  //   nicht mehr "physics.class-ph" wie bei LIKE '%cs.CL%'), GIN-indiziert
  // - primary_category: erste Kategorie, für Präfix-Filter wie "cs."
  // - arxiv_citation_count: Anzahl Zeilen in paper_citation für dieses Paper,
  //   damit Sortieren nach Zitationen nicht jedes Mal zählen muss
  primary_category          String?
  category_list             String[]  @default([])
  arxiv_citation_count      Int       @default(0)

  // UMAP-Koordinaten als echte Spalten. In der DB als
  // GENERATED ALWAYS AS (...) STORED aus `tsne` berechnet
  // (Migration 20261113120000) → NIE selbst schreiben, nur lesen.
  point_x                   Float?    @db.Real
  point_y                   Float?    @db.Real

  // Optimale Suchindizes
  // Für schnelle, stabile Sortierung (published DESC, id DESC)
  @@index([published(sort: Desc), id(sort: Desc)], map: "paper_published_id_idx")

  // Präfix-Filter auf primary_category (LIKE 'cs.%')
  @@index([primary_category(ops: raw("text_pattern_ops"))], map: "paper_primary_category_idx")
  // Hinweis: paper_points_prefix_idx (partieller Covering-Index für
  // GET /papers/points) ist nur in der Migration definiert, weil Prisma
  // INCLUDE und WHERE nicht abbilden kann.

  // Um Kategorien zu durchsuchen (Freitext; für Filter category_list nutzen)
  @@index([categories(ops: raw("gin_trgm_ops"))], type: Gin)

  // schnelle suche einmal nach gezielt titel oder gezielt autoren
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([authors(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([abstract(ops: raw("gin_trgm_ops"))], type: Gin)

  // unsere häufigste query: alle paper einer kategorie, sortiert nach zitationen
  @@index([category_list], type: Gin)
  @@index([arxiv_citation_count(sort: Desc)])

  @@map("paper")
}

model PaperRelation {
  source_id  String @map("source_id")
  target_id  String @map("target_id")
  confidence Float

  @@id([source_id, target_id])
  @@map("paper_relation")
}

model Reference {
  id                       Int    @id @default(autoincrement())
  belonging_paper_entry_id String
  semanticscholar_obj      Json

  @@index([belonging_paper_entry_id])
  @@map("reference")
}

model Citation {
  id                       Int    @id @default(autoincrement())
  belonging_paper_entry_id String
  semanticscholar_obj      Json

  @@index([belonging_paper_entry_id])
  @@map("citation")
}

model PaperCitation {
  belonging_paper_entry_id String
  cited_paper_entry_id     String

  @@id([belonging_paper_entry_id, cited_paper_entry_id])
  @@index([cited_paper_entry_id])
  @@map("paper_citation")
}

model PaperReference {
  belonging_paper_entry_id  String
  referenced_paper_entry_id String

  @@id([belonging_paper_entry_id, referenced_paper_entry_id])

  @@index([referenced_paper_entry_id])
  @@map("paper_reference")
}

model Embedding {
  id                       Int                    @id @default(autoincrement())
  belonging_paper_entry_id String                 @unique
  content                  Unsupported("vector(128)")

  @@map("embedding")
  // CREATE INDEX ON "embedding" USING hnsw (content vector_cosine_ops);
}

model ProgramRun {
  id         Int      @id @default(autoincrement())
  start_date DateTime
  is_active  String   @default("true")

  @@map("program_run")
}

model HistoricalCompletion {
  id                     Int       @id @default(autoincrement())
  program_run_id         Int
  category               String
  start_date             DateTime
  end_date               DateTime?
  goal_oldest_paper_date DateTime?
  goal_reached           String    @default("false")
  reached_date           DateTime?
  oldest_paper_date      DateTime?

  @@map("historical_completion")
}

// Einfache Schlüssel/Wert-Tabelle für Betriebszustände der Python-Anwendung,
// z. B. dataset_import = "complete", sobald der Erstimport vollständig durchlief.
model AppState {
  key        String   @id
  value      String
  updated_at DateTime @default(now())

  @@map("app_state")
}

model UncaughtPaper {
  id           Int       @id @default(autoincrement())
  entry_id     String    @unique
  title        String?
  authors      String?
  abstract     String?
  categories   String?
  published    DateTime?
  url          String?
  retry_count  Int       @default(0)
  max_retries  Int       @default(4)
  last_checked DateTime?
  created_at   DateTime  @default(now())

  // Hinweis: uncaught_paper_retry_id_idx (partiell: retry_count < max_retries)
  // ist nur in der Migration definiert.
  @@map("uncaught_paper")
}
